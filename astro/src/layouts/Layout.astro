---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  defaultTheme?: string;
  favicon?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number | string;
  imageHeight?: number | string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  siteName?: string;
  twitterHandle?: string;
}

const {
  title = "Showayeb Ahamed – Portfolio",
  description = "Welcome to my portfolio! Discover my skills, projects, and work in web development and software engineering.",
  defaultTheme = "dark",
  favicon,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = "website",
  publishedTime,
  author = "Showayeb Ahamed",
  siteName = "Showayeb Ahamed",
  twitterHandle = "@showayebdev",
} = Astro.props;

const initialThemeClass =
  defaultTheme === "light" || defaultTheme === "a_light" ? "light" : "dark";

const getFaviconType = (url?: string) => {
  if (!url) return undefined;
  const clean = url.split("?")[0].toLowerCase();
  if (clean.endsWith(".svg")) return "image/svg+xml";
  if (clean.endsWith(".png")) return "image/png";
  if (clean.endsWith(".ico")) return "image/x-icon";
  if (clean.endsWith(".webp")) return "image/webp";
  if (clean.endsWith(".jpg") || clean.endsWith(".jpeg")) return "image/jpeg";
  if (clean.endsWith(".gif")) return "image/gif";
  return undefined;
};

const faviconType = getFaviconType(favicon);

// Canonical and base site URL
const siteUrl = (
  Astro.site
    ? Astro.site.toString()
    : (import.meta.env.PUBLIC_SITE_URL || "https://showayeb.dev")
).replace(/\/+$/, "");

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Ensure image is a valid absolute URL for social crawlers (WhatsApp, Facebook, Twitter, Telegram, Discord)
function resolveAbsoluteImageUrl(img?: string): string {
  if (!img) return `${siteUrl}/media/profile-pic.webp`;
  if (/^https?:\/\//i.test(img)) return img;
  const cleanPath = img.startsWith("/") ? img : `/${img}`;
  return `${siteUrl}${cleanPath}`;
}

const ogImage = resolveAbsoluteImageUrl(image);

function getMimeType(url: string): string {
  const clean = url.split("?")[0].toLowerCase();
  if (clean.endsWith(".png")) return "image/png";
  if (clean.endsWith(".webp")) return "image/webp";
  if (clean.endsWith(".svg")) return "image/svg+xml";
  if (clean.endsWith(".gif")) return "image/gif";
  if (clean.endsWith(".jpg") || clean.endsWith(".jpeg")) return "image/jpeg";
  return "image/webp";
}

const ogImageType = getMimeType(ogImage);
const ogImageAlt = imageAlt || title || siteName;
---

<!doctype html>
<html lang="en" class={initialThemeClass} data-config-theme={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {favicon ? (
      <>
        {faviconType ? (
          <link rel="icon" type={faviconType} href={favicon} />
        ) : (
          <link rel="icon" href={favicon} />
        )}
        <link rel="shortcut icon" href={favicon} />
        <link rel="apple-touch-icon" href={favicon} />
      </>
    ) : (
      <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    )}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WhatsApp / Facebook / LinkedIn / Discord / Telegram -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Montserrat:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <!-- Zero-Flash Theme Script -->
    <script is:inline define:vars={{ defaultTheme }}>
      (function() {
        function applyCurrentTheme() {
          try {
            var config = defaultTheme || 'dark';
            var html = document.documentElement;
            var active = 'dark';

            if (config === 'dark') {
              active = 'dark';
            } else if (config === 'light') {
              active = 'light';
            } else {
              var stored = localStorage.getItem('theme');
              if (config === 'auto') {
                if (stored === 'light' || stored === 'dark') {
                  active = stored;
                } else {
                  active = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
                }
              } else if (config === 'a_light') {
                active = stored === 'dark' ? 'dark' : 'light';
              } else {
                active = stored === 'light' ? 'light' : 'dark';
              }
            }

            html.classList.remove('light', 'dark');
            html.classList.add(active);
          } catch(e) {}
        }

        applyCurrentTheme();
        document.addEventListener('astro:after-swap', applyCurrentTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-color)] text-[var(--text-color)] transition-colors duration-300 antialiased selection:bg-[var(--link-color)] selection:text-white">
    <slot />
  </body>
</html>
