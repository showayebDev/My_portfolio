---
interface Props {
  platform?: string;
  icon?: any;
  iconUrl?: string;
  className?: string;
}

const {
  platform = "",
  icon = null,
  iconUrl = "",
  className = "w-4 h-4",
} = Astro.props;

// Check for custom uploaded / configured icon first
