---
interface Props {
  projectData?: any[];
}

const { projectData = [] } = Astro.props;

const tapeColors = [
  "washi-tape-amber",
  "washi-tape-sage",
  "washi-tape-cyan",
  "washi-tape-coral",
  "washi-tape-lavender",
  "washi-tape-rose",
];

const publishedProjects = projectData.filter((p) => p._status !== "draft");
---

<section class="collage-card p-6 sm:p-7 relative overflow-visible anim-fade-up anim-delay-150" id="project">
  <!-- Top Washi Tape -->
  <div class="washi-tape washi-tape-center washi-tape-coral"></div>

  <!-- Section Header -->
  <div class="flex flex-wrap justify-between items-center gap-3 mb-6 pb-3 border-b-2 border-dashed border-[var(--border-subtle)]">
    <div class="flex items-center gap-2.5">
      <span class="dymo-label">
        ✦ PROJECTS ✦
      </span>
      <span class="collage-handwritten text-xl font-bold text-[var(--link-color)] -rotate-1 hidden sm:inline">
        Selected Works
      </span>
    </div>
    <a
      href="/project"
      class="postage-stamp bg-[var(--card-kraft-color)] hover:bg-[var(--card-bg-color)] border-dashed border-[var(--border-color)] text-xs font-bold uppercase tracking-wider text-[var(--link-color)] transition-transform hover:scale-105"
    >
      🎟️ VIEW ARCHIVE →
    </a>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {publishedProjects.map((project, idx) => {
      const slug = project.slug || project.name;
      const imgSrc = (typeof project.image === "object" && project.image?.url)
        ? project.image.url
        : project.imageUrl || project.img || null;
      const tapeColor = tapeColors[idx % tapeColors.length];

      return (
        <a
          href={`/project/${slug}`}
          class="block group"
        >
          <div class="p-4 bg-[var(--card-note-color)] hover:bg-[var(--card-kraft-color)] border border-[var(--border-color)] rounded-xl transition-all duration-250 cursor-pointer shadow-sm relative overflow-visible hover:-translate-y-1.5 hover:shadow-md">
            <!-- Decorative Corner Tape -->
            <div
              class={`washi-tape ${tapeColor} !w-[55px] !h-[14px] !top-[-7px] !right-[12px] !transform !rotate-3`}
            ></div>

            <div class="flex items-center gap-3.5">
              <!-- Mini Polaroid Photo Frame -->
              <div class="w-16 h-16 rounded-lg overflow-hidden border border-[var(--border-subtle)] bg-[var(--card-bg-color)] p-1 shrink-0 shadow-sm relative group-hover:scale-105 group-hover:-rotate-2 transition-transform">
                {imgSrc ? (
                  <img
                    src={imgSrc}
                    alt={project.title}
                    width="64"
                    height="64"
                    class="w-full h-full object-contain rounded"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-xl bg-[var(--card-kraft-color)]">
                    🎨
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0 text-left">
                <div class="flex items-center gap-2">
                  <h4 class="collage-serif text-base font-bold text-[var(--text-color)] group-hover:text-[var(--link-color)] transition-colors truncate">
                    {project.title}
                  </h4>
                </div>
                <p class="text-xs text-[var(--secondary-text-color)] line-clamp-2 mt-0.5 font-medium leading-relaxed">
                  {project.description}
                </p>
              </div>

              <!-- Arrow Seal -->
              <div class="shrink-0 w-8 h-8 rounded-full border border-[var(--border-color)] bg-[var(--card-bg-color)] flex items-center justify-center text-[var(--text-color)] group-hover:bg-[var(--btn-2-bg)] group-hover:text-[var(--btn-2-text)] transition-colors shadow-sm">
                <svg
                  class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M9 5l7 7-7 7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                  />
                </svg>
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>
