---
interface Props {
  educationData?: any[];
}

const { educationData = [] } = Astro.props;

const list = [...(educationData || [])].sort(
  (a, b) => (Number(b.sortOrder) || 0) - (Number(a.sortOrder) || 0)
);

if (!list.length) return null;
---

<section class="collage-card p-6 sm:p-7 relative overflow-visible anim-fade-up anim-delay-100">
  <!-- Washi Tape Accent -->
  <div class="washi-tape washi-tape-corner-left washi-tape-cyan"></div>

  <!-- Section Header -->
  <div class="flex flex-wrap justify-between items-center gap-3 mb-6 pb-3 border-b-2 border-dashed border-[var(--border-subtle)]">
    <div class="flex items-center gap-2.5">
      <span class="dymo-label">
        ✦ EDUCATION ✦
      </span>
    </div>
    <span class="collage-handwritten text-xl font-bold text-[var(--link-color)] -rotate-1">
      Studies & Archival Records
    </span>
  </div>

  <!-- Education Index Cards -->
  <div class={`grid gap-4 sm:gap-5 ${list.length > 1 ? "grid-cols-1 md:grid-cols-2 lg:grid-cols-1" : "grid-cols-1"}`}>
    {list.map((edu, idx) => {
      const imgSrc = (typeof edu.logo === "object" && edu.logo?.url)
        ? edu.logo.url
        : edu.logoUrl || (edu.src || null);
      const period = edu.period || edu.direction || "";
      const isAlt = idx % 2 === 1;

      return (
        <div
          class={`p-4 sm:p-5 bg-[var(--card-note-color)] hover:bg-[var(--card-kraft-color)] border border-[var(--border-color)] rounded-xl transition-all duration-200 group hover:-translate-y-1 shadow-sm relative flex flex-col sm:flex-row sm:items-center md:flex-col md:items-stretch lg:flex-row lg:items-center justify-between gap-4 ${
            isAlt ? "hover:rotate-[0.5deg]" : "hover:-rotate-[0.5deg]"
          }`}
        >
          <!-- Left/Top: Stamp Seal Logo + Institution Info -->
          <div class="flex items-start sm:items-center md:items-start lg:items-center gap-4 flex-1 min-w-0">
            <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full border border-[var(--border-subtle)] bg-[var(--card-bg-color)] p-1.5 flex items-center justify-center shrink-0 shadow-sm relative group-hover:rotate-6 transition-transform">
              {imgSrc ? (
                <img
                  src={imgSrc}
                  alt={edu.name}
                  width="50"
                  height="50"
                  class="w-full h-full object-contain select-none rounded-full"
                  loading="lazy"
                />
              ) : (
                <span class="text-xl">🎓</span>
              )}
            </div>

            <div class="flex-1 min-w-0">
              <h4 class="collage-serif text-base font-bold text-[var(--text-color)] group-hover:text-[var(--link-color)] transition-colors">
                {edu.name}
              </h4>
              <p class="text-xs text-[var(--secondary-text-color)] mt-0.5 font-medium leading-relaxed">
                {edu.description}
              </p>
            </div>
          </div>

          <!-- Right/Bottom: Date Postage Stamp Badge -->
          {period && (
            <div class="self-start sm:self-auto md:self-end md:w-full md:pt-2.5 md:border-t md:border-dashed md:border-[var(--border-subtle)] lg:w-auto lg:pt-0 lg:border-t-0 shrink-0 flex md:justify-end">
              <span class="postage-stamp bg-[var(--card-bg-color)] border-dashed border-[var(--border-color)] text-[11px] text-[var(--text-color)]">
                📅 {period}
              </span>
            </div>
          )}
        </div>
      );
    })}
  </div>
</section>
