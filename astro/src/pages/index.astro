---
import Layout from '../layouts/Layout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import { getPortfolioData } from '../lib/api.js';

const { profile, education, skills, categories, projects } = await getPortfolioData();

const title = profile?.siteTitle || (profile?.name ? `${profile.name} – Portfolio` : "Showayeb Ahamed – Portfolio");
const description = profile?.siteDescription || profile?.bio || "Welcome to my portfolio! Discover my skills, projects, and work in web development.";
const defaultTheme = profile?.theme || "dark";
const showPercent = typeof profile?.showPercent === "boolean" ? profile.showPercent : false;

const avatarSrc = (typeof profile?.avatar === "object" && profile?.avatar?.url)
  ? profile.avatar.url
  : (typeof profile?.avatar === "string" ? profile.avatar : (profile?.avatarUrl || null));

const socials = Array.isArray(profile?.socials) ? profile.socials : [];
const twitterSocial = socials.find(
  (s: any) => s.platform?.toLowerCase() === "twitter" || s.name?.toLowerCase().includes("twitter") || s.name?.toLowerCase().includes("x")
);
let twitterHandle = "@showayebdev";
if (twitterSocial?.name && twitterSocial.name.startsWith("@")) {
  twitterHandle = twitterSocial.name;
} else if (twitterSocial?.url) {
  const match = twitterSocial.url.match(/(?:twitter\.com|x\.com)\/([^/?#]+)/i);
  if (match) twitterHandle = `@${match[1]}`;
}
---

<Layout
  title={title}
  description={description}
  defaultTheme={defaultTheme}
  image={avatarSrc || "/media/profile-pic.webp"}
  imageAlt={`${profile?.name || "Showayeb Ahamed"}`}
  favicon={avatarSrc || undefined}
  siteName={profile?.name || "Showayeb Ahamed"}
  twitterHandle={twitterHandle}
>
  <div class="relative min-h-screen overflow-visible">
    <!-- Background Decorative Collage Tape Accent -->
    <div class="hidden xl:block fixed top-6 right-8 pointer-events-none select-none z-0">
      <div class="washi-tape washi-tape-sage !w-[100px] !h-[24px] rotate-12 shadow-sm"></div>
    </div>

    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 px-4 md:px-8 lg:px-12 py-8 relative z-10">
      <ProfileCard profile={profile} />
      <main class="flex-1 space-y-8" id="about">
        <About educationData={education} />
        <Projects projectData={projects} />
        <Skills
          skillsData={skills}
          categoriesData={categories}
          showPercent={showPercent}
        />
      </main>
    </div>
  </div>
</Layout>
