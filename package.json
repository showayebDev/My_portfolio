{
  "name": "my-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Monorepo: Astro SSG Frontend & Payload CMS Backend",
  "scripts": {
    "start": "npm run start --prefix payload-cms",
    "start:cms": "npm run start --prefix payload-cms",
    "start:astro": "npm run preview --prefix astro",
    "dev:cms": "npm run dev --prefix payload-cms",
    "dev:astro": "npm run dev --prefix astro",
    "build": "npm run build:cms && npm run build:astro",
    "build:cms": "npm run build --prefix payload-cms",
    "build:astro": "npm run build --prefix astro",
    "install:cms": "npm install --prefix payload-cms",
    "install:astro": "npm install --prefix astro",
    "install:all": "npm install --prefix payload-cms && npm install --prefix astro",
    "docker:build": "npm run docker:build:all",
    "docker:build:cms": "docker build --target cms -t showayebdev/my_portfolio:latest .",
    "docker:build:astro": "docker build --target astro -t showayebdev/my_portfolio_astro:latest .",
    "docker:build:all": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:full:up": "docker compose -f docker-compose.full.yml up -d",
    "docker:full:down": "docker compose -f docker-compose.full.yml down",
    "docker:push": "docker push showayebdev/my_portfolio:latest",
    "docker:push:cms": "docker push showayebdev/my_portfolio:latest",
    "docker:push:astro": "docker push showayebdev/my_portfolio_astro:latest",
    "docker:push:all": "docker compose push",
    "docker:publish": "npm run docker:publish:all",
    "docker:publish:all": "npm run docker:build:cms && npm run docker:build:astro && npm run docker:push:cms && npm run docker:push:astro"
  }
}
