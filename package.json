{
  "name": "my-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Monorepo: Astro SSG Frontend & Payload CMS Backend",
  "scripts": {
    "start:cms": "npm run start --prefix payload-cms",
    "start:astro": "npm run preview --prefix astro",
    "dev:cms": "npm run dev --prefix payload-cms",
    "dev:astro": "npm run dev --prefix astro",
    "build": "npm run build:cms && npm run build:astro",
    "build:cms": "npm run build --prefix payload-cms",
    "build:astro": "npm run build --prefix astro",
    "install:cms": "npm install --prefix payload-cms",
    "install:astro": "npm install --prefix astro",
    "install:all": "npm install --prefix payload-cms && npm install --prefix astro"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
