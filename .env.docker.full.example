# ============================================================
# Full Docker Stack Environment Configuration (.env.docker.full)
# Used with: docker compose -f docker-compose.full.yml up -d (or npm run docker:full:up)
# Includes self-hosted PostgreSQL and MinIO S3 services!
# Copy this file to .env.docker.full:
#   cp .env.docker.full.example .env.docker.full
# ============================================================

# ============================================================
# 1. Astro Frontend Configuration (astro service)
# ============================================================
# Public URL for Astro frontend (used for sitemap.xml, robots.txt, canonical SEO)
PUBLIC_SITE_URL=http://localhost:4321

# Internal Payload CMS URL for Astro inside Docker network
PAYLOAD_URL=http://app:3000

# ============================================================
# 2. Payload CMS Backend Configuration (app service)
# ============================================================
# Secret key used for session encryption and JWT tokens (Required)
PAYLOAD_SECRET=your-random-strong-secret-key-min-32-chars

# CMS public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Database Configuration (Self-Hosted PostgreSQL Container)
# ============================================================
# Connects to the local 'postgres' container defined in docker-compose.full.yml
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/portfolio?sslmode=disable

# ============================================================
# S3 Storage Configuration (Self-Hosted MinIO Container)
# ============================================================
# MinIO bucket name
S3_BUCKET=my-portfolio

# MinIO root credentials (matches environment in docker-compose.full.yml)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Internal S3 endpoint for backend server uploads inside Docker network
S3_ENDPOINT=http://s3:9000

# Region (standard us-east-1 for MinIO)
S3_REGION=us-east-1

# Must be true for MinIO and Cloudflare R2
S3_FORCE_PATH_STYLE=true

# Public URL accessible from browser to view and download uploaded media assets
S3_PUBLIC_URL=http://localhost:9000/my-portfolio

# ============================================================
# API Documentation (Swagger UI)
# ============================================================
# Set to true to expose Swagger UI at /api/docs
ENABLE_SWAGGER=true

# ============================================================
# Cloudflare Workers / Pages Deploy Hook (Auto Rebuild Frontend)
# ============================================================
# Automatically triggered when saving/updating content in Payload CMS
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/workers/builds/deploy_hooks/<your-deploy-hook-uuid>

