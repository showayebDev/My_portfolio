# ============================================================
# Docker Compose Environment Configuration (.env.docker)
# Used with: docker compose up -d (or npm run docker:up)
# Copy this file to .env.docker and customize your values:
#   cp .env.docker.example .env.docker
# ============================================================

# ============================================================
# 1. Astro Frontend Configuration (astro service)
# ============================================================
# Public URL for Astro frontend (used for sitemap.xml, robots.txt, canonical SEO)
PUBLIC_SITE_URL=https://showayeb.dev

# Internal or external Payload CMS URL for Astro to fetch content during build/runtime
# Defaults to http://app:3000 inside the Docker network
PAYLOAD_URL=http://app:3000

# ============================================================
# 2. Payload CMS Backend Configuration (app service)
# ============================================================
# Secret key used for session encryption and JWT tokens (Required)
PAYLOAD_SECRET=your-random-strong-secret-key-min-32-chars

# CMS public site URL
NEXT_PUBLIC_SITE_URL=https://payload-cms.showayeb.dev

# ============================================================
# Database Configuration (PostgreSQL or MongoDB)
# ============================================================
# Connect to your cloud database (Neon, Supabase, MongoDB Atlas, etc.):
# PostgreSQL Example:
DATABASE_URL=postgresql://<user>:<password>@ep-xyz.neon.tech/neondb?sslmode=require

# MongoDB Example:
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/my-portfolio?retryWrites=true&w=majority

# ============================================================
# Cloudflare R2 / AWS S3 Storage (via S3-compatible API)
# ============================================================
# Bucket name (e.g. my-portfolio)
S3_BUCKET=my-portfolio

# S3 Access Keys (e.g. from Cloudflare R2 API Tokens or AWS IAM)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# S3 Endpoint URL (for Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Region ('auto' for Cloudflare R2, 'us-east-1' for AWS S3)
S3_REGION=auto

# Path Style (Must be true for Cloudflare R2, MinIO, and Appwrite)
S3_FORCE_PATH_STYLE=true

# Optional: Public CDN / Bucket URL (if custom domain or r2.dev public access is enabled)
# S3_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# ============================================================
# API Documentation (Swagger UI)
# ============================================================
# Set to true to expose Swagger UI publicly at /api/docs in production
ENABLE_SWAGGER=false

# ============================================================
# Cloudflare Workers / Pages Deploy Hook (Auto Rebuild Frontend)
# ============================================================
# Automatically triggered when saving/updating content in Payload CMS
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/workers/builds/deploy_hooks/<your-deploy-hook-uuid>

