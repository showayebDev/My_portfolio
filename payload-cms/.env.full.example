# ============================================================
# Full Docker Stack Configuration (.env.full)
# Use with: docker compose -f docker-compose.full.yml up -d
# ============================================================

# Secret key for Payload CMS sessions and auth
PAYLOAD_SECRET=

# Frontend site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Database Configuration (Local PostgreSQL Service)
# ============================================================
# Connects to the local 'postgres' container in docker-compose.full.yml
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/portfolio?sslmode=disable

# ============================================================
# S3 Storage Configuration (Local MinIO S3 Service)
# ============================================================
# MinIO bucket name
S3_BUCKET=my-portfolio

# MinIO root credentials
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Internal S3 endpoint for backend server uploads
S3_ENDPOINT=http://s3:9000

# Region (standard us-east-1 for MinIO/S3 API)
S3_REGION=us-east-1

# Must be true for MinIO and Cloudflare R2
S3_FORCE_PATH_STYLE=true

# Public URL accessible from browser to view/download media assets
# Points to localhost:9000 MinIO server
S3_PUBLIC_URL=http://localhost:9000/my-portfolio

# ============================================================
# API Documentation (Swagger UI)
# ============================================================
# Enabled by default in development mode (NODE_ENV !== 'production').
# In production, set to true if you wish to publicly expose Swagger UI at /api/docs.
# ENABLE_SWAGGER=true
