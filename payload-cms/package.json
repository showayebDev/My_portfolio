{
  "name": "payload-cms",
  "version": "1.0.0",
  "description": "Payload CMS Backend for Portfolio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "version:gen": "node scripts/generate-version.mjs",
    "clean:lock": "node -e \"import('fs').then(fs => { if (fs.existsSync('.next/lock')) fs.unlinkSync('.next/lock'); })\"",
    "build": "node scripts/generate-version.mjs && npm run clean:lock && cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first --max-old-space-size=8000\" next build --webpack",
    "dev": "node scripts/generate-version.mjs && cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next dev",
    "develop": "node scripts/generate-version.mjs && cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next dev",
    "devsafe": "node scripts/generate-version.mjs && rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" payload generate:types",
    "ii": "npm install",
    "lint": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" eslint .",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" payload",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@payloadcms/db-mongodb": "^3.92.0",
    "@payloadcms/db-postgres": "^3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "^3.92.0",
    "@payloadcms/storage-s3": "^3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@uiw/react-md-editor": "^4.1.3",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.9",
    "github-markdown-css": "^5.9.0",
    "graphql": "^17.0.2",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.1",
    "next": "16.4.3",
    "nextjs-toploader": "^3.9.17",
    "payload": "3.92.0",
    "payload-oapi": "^0.3.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
