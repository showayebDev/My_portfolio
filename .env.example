# A generated secret for Payload
PAYLOAD_SECRET=

# ============================================================
# Site Configuration
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Database Configuration (Auto-detected from DATABASE_URL protocol)
# ============================================================
# Connects to PostgreSQL (Neon/Supabase) or MongoDB automatically:
# For MongoDB:
DATABASE_URL=mongodb://127.0.0.1:27017/my-portfolio
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/my-portfolio?retryWrites=true&w=majority

# For PostgreSQL:
# DATABASE_URL=postgresql://<user>:<password>@ep-xyz.neon.tech/neondb?sslmode=require

# ============================================================
# Cloudflare R2 / AWS S3 Storage (via S3 API)
# ============================================================
# 1. Bucket name (e.g. my-portfolio)
S3_BUCKET=my-portfolio

# 2. Cloudflare R2 API Tokens (Dashboard -> R2 -> Manage R2 API Tokens -> Create Token)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 3. Cloudflare R2 S3 Endpoint:
# Replace <ACCOUNT_ID> with your Cloudflare Account ID
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# 4. Region ('auto' is standard for Cloudflare R2, 'us-east-1' for AWS S3)
S3_REGION=auto

# 5. Force Path Style (Must be true for Cloudflare R2, Appwrite & MinIO)
S3_FORCE_PATH_STYLE=true

# 6. Optional: Public CDN / Bucket URL (if you enabled Custom Domain or r2.dev in Cloudflare R2 settings)
# S3_PUBLIC_URL=https://pub-xxxxxx.r2.dev
